# ============================================================
# PLANTILLA BASE DEM — Variables de Entorno del Backend
# Copiar este archivo como .env y completar los valores
# ============================================================

# Aplicacion Django
DEBUG=True
SECRET_KEY=django-insecure-plantilla-dem-key-cambiar-en-produccion

# === Base de Datos PostgreSQL ===
# Cambia estos valores por los de tu servidor PostgreSQL
DB_NAME=plantilla_db
DB_USER=postgres
DB_PASS=tu_contrasea_aqui
DB_HOST=localhost
DB_PORT=5432
